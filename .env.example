# ==============================================================================
# Vault Platform Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
VAULT_PORT=80

# Security & Cryptography
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Central PostgreSQL Server on PC 4)
# In local docker-compose, use 'db' as server. In production, use PC 4's IP (e.g. 192.168.1.104).
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vault
POSTGRES_USER=vault_app
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# Persistent Storage
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/data/images
STORAGE_MAX_FILE_SIZE_MB=25

# Optional S3 / MinIO Object Storage (Future Data Centre Expansion)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=vault-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# CORS Origins (Comma-separated URLs permitted to communicate with API)
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# CI / CD & Nexus Registry (Used by Jenkinsfile)
NEXUS_REGISTRY=nexus.internal:8082
NEXUS_CREDENTIALS_ID=nexus-registry-credentials
SONAR_SERVER_URL=http://sonarqube.internal:9000
PC3_DEPLOY_SSH_CREDENTIALS_ID=pc3-deploy-ssh-key
PC3_HOST=pc3.internal
